# ==============================================================================
# CodeConClave Pro — Environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# ==============================================================================

# ---- APP ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
APP_NAME=CodeConClave
LOG_LEVEL=info
# 32+ random characters. Generate: openssl rand -hex 32
SESSION_SECRET=replace_with_random_hex_32_bytes
JWT_SECRET=replace_with_random_hex_32_bytes
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
# -----------------------------------------------------------------------------
# PRODUCTION GUARD (Phase 18): with NODE_ENV=production the server refuses to
# start unless SESSION_SECRET and JWT_SECRET are strong random values (not the
# dev defaults) AND SESSION_COOKIE_SECURE=true AND CSP_ENABLED=true.
# -----------------------------------------------------------------------------

# ---- DATABASE (Supabase PostgreSQL or local) ----
DATABASE_URL=postgresql://codeconclave:codeconclave_dev_password@localhost:5432/codeconclave
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SSL for hosted Postgres. Set "true" when using Supabase.
DATABASE_SSL=false

# ---- REDIS (Upstash or local) ----
REDIS_URL=redis://localhost:6379
# true = use BullMQ/Redis queues; false = honest in-memory queue for local dev
QUEUE_PROVIDER=memory

# ---- AUTH ----
AUTH_ISSUER=codeconclave
AUTH_ACCESS_TOKEN_TTL=900
AUTH_SESSION_TTL_DAYS=30
AUTH_REMEMBER_DAYS=90
# 0 = disabled, 60 = require MFA for high-risk actions
MFA_REQUIREMENT_LEVEL=0
MFA_MAX_ATTEMPTS=5
RECOVERY_CODE_COUNT=10

# ---- GOOGLE (existing OAuth client — do not create a second one) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# CROSS-BROWSER AUTH FIX: the redirect URI MUST be on the SAME ORIGIN as the
# SPA (the frontend proxies /api/* to the backend), otherwise the session
# cookie lands on the backend host and the SPA keeps 401ing on /me.
#   - Local dev:  http://localhost:5173/api/v1/auth/google/callback
#   - Production: https://<your-frontend-domain>/api/v1/auth/google/callback
# Register this exact URI in Google Cloud Console (Authorized redirect URIs).
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# If frontend and backend share the same registrable host but differ in
# subdomain (e.g. www.example.com vs api.example.com and the callback is NOT
# proxied through the SPA), set this to the shared domain (e.g. example.com)
# so the session cookie is accepted on both. Leave empty when the callback
# flows through the SPA proxy (recommended, cookie stays host-scoped).
AUTH_COOKIE_DOMAIN=
GOOGLE_OAUTH_CONSENT_MODE=consent
# Enabled APIs: Gmail, Drive, Sheets, Calendar
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/calendar.events

# ---- AI (at least one provider key required for AI features) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Stage 25.5 multi-model gateway expansion (OpenAI-compatible adapters + Cohere)
GROK_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
# Prompt 1 provider expansion
QWEN_API_KEY=
DEVIN_API_KEY=
DEVIN_ORG_ID=
# CODECONCLAVE PRO pre-Prompt 3 provider key preparation (verified identities;
# empty = ENVIRONMENT_BLOCKED until keys are supplied at the Provider Config gate)
OX_ALPHA_API_KEY=
MANUS_API_KEY=
Z_AI_API_KEY=
# BIG_PICKLE: identity verified via the OpenCode Zen gateway but NOT
# production-ready (free smoke-test tier; some aggregators list it disabled).
# DO NOT ADD OPENCODE_ZEN_API_KEY YET - see docs/CODECONCLAVE_NEW_PROVIDER_API_KEYS.md.
# Launch provider set (production) = Gemini, Nemotron, Mistral only.
# Other adapters stay implementable via explicit override, never on by default:
# anthropic,openai,mistral,grok,deepseek,kimi,nemotron,north,
# qwen,gemma,devin,ox_alpha,manus,z_code_5_3
AI_PROVIDERS_ENABLED=google,nemotron,mistral
AI_DEFAULT_MODEL=
AI_PREMIUM_BUDGET_USD_PER_DAY=4
AI_MODEL_REFRESH_MINUTES=10
# Per-request AI timeout in milliseconds (default 120000)
AI_REQUEST_TIMEOUT_MS=120000
AI_CHAIN_TIMEOUT_MS=180000

# ---- EMAIL (Resend) ----
# Primary rail (long-term architecture). Default EMAIL_TRANSPORT=resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CodeConClave <noreply@example.com>
RESEND_ENABLED=false

# ---- EMAIL TRANSPORT ----
# One rail at a time. 'resend' (default) = above. 'gmail' = TEMPORARY zero-cost
# pilot via Gmail SMTP app password; NOT the final production email system.
# For the pilot: create a dedicated account (e.g. codeconclave.dev@gmail.com),
# enable 2FA, then Google Account > Security > 2-Step Verification > App
# passwords and generate one. Never commit the real password.
EMAIL_TRANSPORT=resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display sender; defaults to GMAIL_USER when empty.
GMAIL_FROM_EMAIL=

# ---- OTP ----
# OTP code lifetime in minutes (1..60, audit default 10).
OTP_TTL_MINUTES=10

# ---- GITHUB (CodeConClave Pro GitHub App) ----
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
# Deferred until a real production webhook endpoint exists
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=

# ---- RAZORPAY ----
# Current capability: Payment Link auto-activation rail.
# Set RAZORPAY_WEBHOOK_ENABLED=true and RAZORPAY_WEBHOOK_SECRET only after
# registering the signed webhook endpoint (POST /api/v1/payments/webhook/razorpay)
# and subscribing to payment.captured / payment_link.paid / payment.refunded.
# Do NOT fake provider evidence. Payment transitions to VERIFIED only on
# independent provider evidence (webhook signature / API status query).
RAZORPAY_MODE=payment_link
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_ENABLED=false
RAZORPAY_PRO_PAYMENT_LINK=https://rzp.io/rzp/sAgHIpxS
RAZORPAY_TEAM_PAYMENT_LINK=
RAZORPAY_PAYMENT_LINK_STATUS_POLL_MINUTES=30

# ---- PAYMENT LINK-POOL (POLICY B) ----
# Static pre-created Razorpay payment links for automatic activation. The pool
# table (payment_link_pool) is provisioned from this catalogue by the idempotent
# seeder at server boot AND via `npm run db:seed:pool` (backend). INR only: a
# non-INR entry is skipped (never converted). A link's amount MUST equal the
# authoritative plan price (pro=999, team=4999) or it is skipped as unvalidatable.
# PAYMENT_POOL_LINKS is a JSON array of { index, paymentUrl, referenceId, amount,
# currency, plan, callbackPath, paymentLinkId, enabled }.
# Example:
# PAYMENT_POOL_LINKS=[{"index":1,"paymentUrl":"https://rzp.io/rzp/abc123","referenceId":"CCPOOL-PRO-01","amount":999,"currency":"INR","plan":"pro","callbackPath":"/cb/1","paymentLinkId":"plink_x","enabled":true}]
# When unset, a deterministic place-holder catalogue (CCPOOL-<NNN>, UNVERIFIED) is seeded.
PAYMENT_POOL_TTL_MINUTES=15
PAYMENT_POOL_LINKS=
# READ-ONLY payment watchtower ALERT DESTINATION. The watchtower itself is
# GLOBALLY unscoped — it inspects payment state across ALL users/workspaces/
# projects and is NOT an authorization boundary; this value only decides where
# the alert is DELIVERED (via the existing outbox/SMTP configuration). If empty/
# absent the watchtower STILL runs every check and records the full result, and
# emits exactly one ALERT_DESTINATION_UNCONFIGURED warning. Never expose this
# address in frontend responses or audit payloads. Placeholder format only:
# PAYMENT_WATCHTOWER_ALERT_EMAIL=

# ---- CLOUDFLARE (Worker + KV; R2 deferred until billing activated) ----
CLOUDFLARE_WORKER_NAME=codeconclave-pro
CLOUDFLARE_WORKER_URL=https://codeconclave-pro.codeconclave-app.workers.dev
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_BINDING_NAME=
# R2 — deferred. STORAGE_PROVIDER=s3 supports MinIO locally; switch to r2 later.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# ---- STORAGE (provider-agnostic abstraction) ----
# memory = local disk (dev only, honest), s3 = S3-compatible (MinIO dev), r2 = Cloudflare R2 (deferred)
STORAGE_PROVIDER=memory
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/storage
# At-rest encryption for object storage blobs (AES-256-GCM; key derived from
# SESSION_SECRET). "true" required for production object storage.
STORAGE_AT_REST_ENCRYPTION=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=codeconclave_dev
S3_SECRET_ACCESS_KEY=codeconclave_dev_password
S3_BUCKET=codeconclave
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# ---- PLUGINS ----
# Comma-separated allowlist of external hosts that may deliver plugin webhooks
PLUGIN_WEBHOOK_ALLOWED_HOSTS=

# ---- SENTRY (integrate only after real backend exists; no fake reporting) ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLED=false

# ---- PREVIEW (main-workspace live preview; honest NOT_CONFIGURED unless enabled) ----
# Builds run on THIS deployment only (no sandbox server); requires a local
# workspace checkout under PREVIEW_PROJECTS_ROOT and a build command.
PREVIEW_BUILD_ENABLED=false
PREVIEW_BUILD_COMMAND=npm run build
PREVIEW_PROJECTS_ROOT=
PREVIEW_OUTPUT_DIR=

# ---- SECURITY ----
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=60
CSRF_COOKIE_NAME=codeconclave_csrf
CSP_ENABLED=true
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=50

# ---- FREE LIMITS (server-enforced; never faked client-side) ----
FREE_DAILY_MESSAGES=20
FREE_MAX_PROJECTS=1
FREE_STORAGE_GB=2
FREE_MODEL_TIER=efficient

# ---- LOCAL AGENT ----
LOCAL_AGENT_PORT=43121
LOCAL_AGENT_TOKEN_TTL_HOURS=1
LOCAL_AGENT_WS_URL=ws://localhost:4000/agent
