# ==============================================================================
# CodeConClave Pro — Environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# ==============================================================================

# ---- APP ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
APP_NAME=CodeConClave
LOG_LEVEL=info
# 32+ random characters. Generate: openssl rand -hex 32
SESSION_SECRET=replace_with_random_hex_32_bytes
JWT_SECRET=replace_with_random_hex_32_bytes
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
# -----------------------------------------------------------------------------
# PRODUCTION GUARD (Phase 18): with NODE_ENV=production the server refuses to
# start unless SESSION_SECRET and JWT_SECRET are strong random values (not the
# dev defaults) AND SESSION_COOKIE_SECURE=true AND CSP_ENABLED=true.
# -----------------------------------------------------------------------------

# ---- DATABASE (Supabase PostgreSQL or local) ----
DATABASE_URL=postgresql://codeconclave:codeconclave_dev_password@localhost:5432/codeconclave
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SSL for hosted Postgres. Set "true" when using Supabase.
DATABASE_SSL=false

# ---- REDIS (Upstash or local) ----
REDIS_URL=redis://localhost:6379
# true = use BullMQ/Redis queues; false = honest in-memory queue for local dev
QUEUE_PROVIDER=memory

# ---- AUTH ----
AUTH_ISSUER=codeconclave
AUTH_ACCESS_TOKEN_TTL=900
AUTH_SESSION_TTL_DAYS=30
AUTH_REMEMBER_DAYS=90
# 0 = disabled, 60 = require MFA for high-risk actions
MFA_REQUIREMENT_LEVEL=0
MFA_MAX_ATTEMPTS=5
RECOVERY_CODE_COUNT=10

# ---- GOOGLE (existing OAuth client — do not create a second one) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_OAUTH_CONSENT_MODE=consent
# Enabled APIs: Gmail, Drive, Sheets, Calendar
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/calendar.events

# ---- AI (at least one provider key required for AI features) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Stage 25.5 multi-model gateway expansion (OpenAI-compatible adapters + Cohere)
GROK_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
# Comma-separated list of enabled provider ids:
# anthropic,openai,google,mistral,grok,deepseek,kimi,nemotron,north
AI_PROVIDERS_ENABLED=anthropic,openai,google,mistral
AI_DEFAULT_MODEL=
AI_PREMIUM_BUDGET_USD_PER_DAY=4
AI_MODEL_REFRESH_MINUTES=10
# Per-request AI timeout in milliseconds (default 120000)
AI_REQUEST_TIMEOUT_MS=120000
AI_CHAIN_TIMEOUT_MS=180000

# ---- EMAIL (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=CodeConClave <noreply@example.com>
RESEND_ENABLED=false

# ---- GITHUB (CodeConClave Pro GitHub App) ----
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
# Deferred until a real production webhook endpoint exists
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=

# ---- RAZORPAY ----
# Current capability: Payment Link only (API/webhook credentials unavailable).
# Do NOT fake provider evidence. Payment transitions to VERIFIED only on
# independent provider evidence (webhook signature / API status query).
RAZORPAY_MODE=payment_link
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PAYMENT_LINK=https://rzp.io/rzp/sAgHIpxS
RAZORPAY_PAYMENT_LINK_STATUS_POLL_MINUTES=30

# ---- CLOUDFLARE (Worker + KV; R2 deferred until billing activated) ----
CLOUDFLARE_WORKER_NAME=codeconclave-pro
CLOUDFLARE_WORKER_URL=https://codeconclave-pro.codeconclave-app.workers.dev
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_BINDING_NAME=
# R2 — deferred. STORAGE_PROVIDER=s3 supports MinIO locally; switch to r2 later.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# ---- STORAGE (provider-agnostic abstraction) ----
# memory = local disk (dev only, honest), s3 = S3-compatible (MinIO dev), r2 = Cloudflare R2 (deferred)
STORAGE_PROVIDER=memory
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/storage
# At-rest encryption for object storage blobs (AES-256-GCM; key derived from
# SESSION_SECRET). "true" required for production object storage.
STORAGE_AT_REST_ENCRYPTION=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=codeconclave_dev
S3_SECRET_ACCESS_KEY=codeconclave_dev_password
S3_BUCKET=codeconclave
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# ---- PLUGINS ----
# Comma-separated allowlist of external hosts that may deliver plugin webhooks
PLUGIN_WEBHOOK_ALLOWED_HOSTS=

# ---- SENTRY (integrate only after real backend exists; no fake reporting) ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLED=false

# ---- PREVIEW (main-workspace live preview; honest NOT_CONFIGURED unless enabled) ----
# Builds run on THIS deployment only (no sandbox server); requires a local
# workspace checkout under PREVIEW_PROJECTS_ROOT and a build command.
PREVIEW_BUILD_ENABLED=false
PREVIEW_BUILD_COMMAND=npm run build
PREVIEW_PROJECTS_ROOT=
PREVIEW_OUTPUT_DIR=

# ---- SECURITY ----
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=60
CSRF_COOKIE_NAME=codeconclave_csrf
CSP_ENABLED=true
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=50

# ---- FREE LIMITS (server-enforced; never faked client-side) ----
FREE_DAILY_MESSAGES=20
FREE_MAX_PROJECTS=1
FREE_STORAGE_GB=2
FREE_MODEL_TIER=efficient

# ---- LOCAL AGENT ----
LOCAL_AGENT_PORT=43121
LOCAL_AGENT_TOKEN_TTL_HOURS=1
LOCAL_AGENT_WS_URL=ws://localhost:4000/agent
