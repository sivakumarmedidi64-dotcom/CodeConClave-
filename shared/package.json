{
  "name": "@codeconclave/shared",
  "version": "0.1.0",
  "private": true,
  "description": "CodeConClave shared domain types, schemas, and constants",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
