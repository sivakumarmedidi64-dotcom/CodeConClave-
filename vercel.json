{
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://codeconclave-api.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://codeconclave-api.onrender.com/health"
    },
    {
      "source": "/healthz",
      "destination": "https://codeconclave-api.onrender.com/healthz"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}