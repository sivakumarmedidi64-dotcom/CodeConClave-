{
  "name": "@codeconclave/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeConClave backend — modular monolith (Express + TypeScript + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:migrate:down": "tsx src/database/migrate.ts down",
    "db:migrate:status": "tsx src/database/migrate.ts status",
    "db:seed": "tsx src/database/migrate.ts up",
    "worker": "tsx src/workers/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.714.0",
    "@codeconclave/shared": "*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "ioredis": "^5.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
